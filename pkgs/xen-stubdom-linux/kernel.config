# Minimal PV kernel for a Linux device-model stubdomain, applied on top of
# `make allnoconfig`. Based on the config fragments of Qubes OS
# (QubesOS/qubes-vmm-xen-stubdom-linux, linux/config), without the GCC
# plugins and without usbip/pulseaudio.

## base (tiny.config)
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLUB=y
CONFIG_COMPACTION=y
CONFIG_JUMP_LABEL=y
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_UNWINDER_GUESS=y
CONFIG_64BIT=y
CONFIG_VMAP_STACK=y
CONFIG_SPARSEMEM_VMEMMAP=y

## hardening
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_PAGE_POISONING=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_STACKOVERFLOW=y
CONFIG_X86_MCE=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
CONFIG_MITIGATION_RETPOLINE=y

## initramfs (gzip, see the rootfs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INOTIFY_USER=y

## misc
CONFIG_NO_HZ_IDLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_LOCALVERSION="-xen-stubdom"
CONFIG_DEFAULT_HOSTNAME="xen-stubdom"
CONFIG_CMDLINE_BOOL=y
# quiet: dom0 qemu (11) does not drain the stubdomain console (console 0);
# hvc_xen then spins on a full ring. stubdomain_cmdline = "loglevel=7" to debug.
# xen_privcmd.unrestricted: since the domU restriction (6.6.y backport),
# privcmd refuses the generic hypercall ioctl qemu needs for its target
# (populate_physmap, ioreq server); the stubdomain is that target's helper
CONFIG_CMDLINE="clocksource=tsc quiet loglevel=0 xen_privcmd.unrestricted=1"

## Xen PV guest
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_XEN=y
CONFIG_XEN_PV=y
CONFIG_XEN_512GB=y
CONFIG_XENFS=y
CONFIG_XEN_COMPAT_XENFS=y
CONFIG_XEN_PRIVCMD=y
CONFIG_XEN_DEV_EVTCHN=y
CONFIG_XEN_GNTDEV=y
CONFIG_XEN_GRANT_DEV_ALLOC=y

## Xen console (QMP log, save/restore consoles)
CONFIG_TTY=y
CONFIG_HVC_XEN=y
CONFIG_HVC_XEN_FRONTEND=y

## Xen netfront/blkfront: the guest's NICs and disks
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_XEN_NETDEV_FRONTEND=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_XEN_BLKDEV_FRONTEND=y

## what qemu needs
CONFIG_EPOLL=y
CONFIG_FUTEX=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FILE_LOCKING=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_AIO=y

## network: guest NIC (tap) bridged to the stubdomain's vif
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_BRIDGE=y
CONFIG_NET_CORE=y
CONFIG_TUN=y

## PCI passthrough (stage 2: sys-net/sys-usb)
CONFIG_PCI=y
CONFIG_XEN_PCIDEV_FRONTEND=y
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
